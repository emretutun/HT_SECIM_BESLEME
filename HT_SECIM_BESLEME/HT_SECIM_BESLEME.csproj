<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <!-- Ayar dosyalari exe'nin yanina kopyalaniyor; orada elle duzenlenirler.
       PreserveNewest: cikti klasorunde yapilan degisiklik, kaynak dosya
       degismedikce korunur. -->
  <ItemGroup>
    <Content Include="besleme">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ornek\ornek_besleme.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
